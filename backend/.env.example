# Server Configuration
PORT=5000

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/user_auth_system

# JWT Configurations
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_32_characters_long
JWT_EXPIRES_IN=24h

# Nodemailer / Gmail SMTP Configurations
# IMPORTANT: To use Gmail, you must enable 2-Step Verification and create an "App Password"
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-digit-gmail-app-password

# Client Configuration
FRONTEND_URL=http://localhost:5173
